{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "headers": [
    {
      "source": "/api/blogs(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, max-age=0, s-maxage=0, must-revalidate, proxy-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store, s-maxage=0"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store, s-maxage=0"
        }
      ]
    },
    {
      "source": "/blog/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, max-age=0, s-maxage=0, must-revalidate, proxy-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store, s-maxage=0"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store, s-maxage=0"
        }
      ]
    }
  ]
}
